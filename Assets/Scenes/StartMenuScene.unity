  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "1. [\uC9C0\uC18D \uCCB4\uB825 \uAC10\uC18C & Q \uCCB4\uB825 \uAD50\uD658]
    \uD50C\uB808\uC774\uC5B4\uC758 \uCCB4\uB825\uC740 \uC9C0\uC18D\uC801\uC73C\uB85C
    \uAC10\uC18C\uD569\uB2C8\uB2E4.\n   \uCCB4\uB825\uC774 \uB0AE\uC744 \uB54C [Q
    \uD0A4]\uB85C 90 HP \uB290\uB9B0 \uC801\uACFC \uCCB4\uB825\uC744 \uB9DE\uBC14\uAFD4
    \uD68C\uBCF5\uD558\uC138\uC694! (\uAD50\uD658\uB41C \uC801\uC740 \uB3CC\uC9C4)\n\n2.
    [\uD398\uC774\uC988 \uBD84\uAE30 \uC2DC\uC2A4\uD15C] \uC0DD\uC874 \uC2DC\uAC04
    30\uCD08\uB9C8\uB2E4 \uD398\uC774\uC988\uAC00 \uC0C1\uC2B9\uD569\uB2C8\uB2E4.\n  
    \u2022 Phase 1 (0~30\uCD08): 2.0\uCD08 \uAC04\uACA9, 1\uB9C8\uB9AC\uC529 \uC2A4\uD3F0
    (\uCD5C\uB300 3\uB9C8\uB9AC)\n   \u2022 Phase 2 (30~60\uCD08): 1.2\uCD08 \uAC04\uACA9,
    2\uB9C8\uB9AC \uB3D9\uC2DC \uC2A4\uD3F0 (\uCD5C\uB300 6\uB9C8\uB9AC)\n   \u2022
    Phase 3 (60\uCD08 \uC774\uD6C4): 0.6\uCD08 \uAC04\uACA9, 3\uB9C8\uB9AC \uB3D9\uC2DC
    \uC2A4\uD3F0 (\uCD5C\uB300 10\uB9C8\uB9AC)\n\n3. [30\uCD08 \uC8FC\uAE30 \uB2A5\uB825
    \uCE74\uB4DC \uAD50\uD658] \uB9E4 30\uCD08\uB9C8\uB2E4 \uC0C1\uB300 \uC2AC\uB86F(3\uAC1C)
    \uC911 \uAC00\uC838\uC62C \uB2A5\uB825 1\uAC1C\uB97C \uACE0\uB974\uBA74,\n  
    AI\uAC00 \uB0B4 \uC2AC\uB86F(3\uAC1C) \uC911 1\uAC1C\uB97C 33.3% \uD655\uB960\uB85C
    \uC120\uD0DD\uD574 1:1 \uB9DE\uAD50\uD658\uD569\uB2C8\uB2E4. ([Esc]\uB85C \uC0C1\uC2DC
    \uD655\uC778 \uAC00\uB2A5)"
