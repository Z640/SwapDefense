  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 0
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "1. [\uC9C0\uC18D \uCCB4\uB825 \uAC10\uC18C] \uD50C\uB808\uC774\uC5B4\uC758
    \uCCB4\uB825\uC740 \uCD5C\uB300 100\uC5D0\uC11C \uC2DC\uC791\uD574 \uCD08\uB2F9
    3.0\uC529 \uACC4\uC18D \uC904\uC5B4\uB4ED\uB2C8\uB2E4.\n\n2. [\uC801 \uC885\uB958]
    \uBE60\uB978 \uC801(\uC8FC\uD669 \uB9C8\uB984\uBAA8, 30 HP, \uB3C4\uCC29 \uD53C\uD574
    10)\uACFC \uB290\uB9B0 \uC801(\uBCF4\uB77C \uC721\uAC01\uD615, 90 HP, \uB3C4\uCC29
    \uD53C\uD574 20)\uC774 \uB4F1\uC7A5\uD569\uB2C8\uB2E4.\n\n3. [Q \uCCB4\uB825
    \uAD50\uD658] \uB9C8\uC6B0\uC2A4\uB85C \uC120\uD0DD\uD55C \uC801\uACFC \uD604\uC7AC
    \uCCB4\uB825\uC744 \uC989\uC2DC \uB9DE\uBC14\uAFC9\uB2C8\uB2E4 (\uCFE8\uD0C0\uC784
    6\uCD08).\n   \uCCB4\uB825\uC774 \uB0AE\uC744 \uB54C 90 HP \uB290\uB9B0 \uC801\uACFC
    \uAD50\uD658\uD574 \uCCB4\uB825\uC744 \uD68C\uBCF5\uD558\uC138\uC694!\n\n4. [\uB3CC\uC9C4
    \uB300\uCC98] \uCCB4\uB825\uC774 \uAD50\uD658\uB41C \uC801\uC740 252 px/s\uB85C
    \uBE60\uB974\uAC8C \uB3CC\uC9C4\uD558\uBA70, \uBC29\uC5B4\uC120\uC5D0 \uB2FF\uC744
    \uB54C \uB0A8\uC740 \uCCB4\uB825\uB9CC\uD07C \uD53C\uD574\uB97C \uC90D\uB2C8\uB2E4.\n  
    [F \uD0A4] \uC5F0\uC18D \uC0AC\uACA9(\uBC1C\uB2F9 \uD53C\uD574 12)\uC73C\uB85C
    \uB3CC\uC9C4\uD558\uB294 \uC801\uC758 \uCCB4\uB825\uC744 \uAE4E\uC544 \uB3C4\uCC29
    \uD53C\uD574\uB97C \uC904\uC774\uAC70\uB098 \uCC98\uCE58\uD558\uC138\uC694!"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: de5644a366ff176498907abccb70f75c, type: 2}
