      m_Calls: []
  m_text: "\u2022 \uD50C\uB808\uC774\uC5B4\uC758 \uCCB4\uB825\uC740 \uCD08\uB2F9
    3.0\uC529 \uC9C0\uC18D\uC801\uC73C\uB85C \uAC10\uC18C\uD569\uB2C8\uB2E4.\n\u2022
    [F \uD0A4] \uC870\uC900 \uBC29\uD5A5\uC73C\uB85C \uC0AC\uACA9 (\uAE38\uAC8C \uB204\uB974\uBA74
    0.25\uCD08 \uAC04\uACA9 \uC5F0\uC0AC, \uBC1C\uB2F9 \uD53C\uD574 12)\n\u2022 [Q
    \uD0A4] \uC870\uC900\uC810\uC5D0 \uC120\uD0DD\uB41C \uC801\uACFC \uD604\uC7AC
    \uCCB4\uB825\uC744 \uC989\uC2DC \uB9DE\uBC14\uAFC9\uB2C8\uB2E4 (\uCFE8\uD0C0\uC784
    6\uCD08)\n\u2022 \uCCB4\uB825\uC774 \uAD50\uD658\uB41C \uC801\uC740 252 px/s\uB85C
    \uB3CC\uC9C4\uD558\uBA70, \uB3C4\uCC29 \uC2DC \uB0A8\uC740 \uD604\uC7AC \uCCB4\uB825\uB9CC\uD07C
    \uD53C\uD574\uB97C \uC90D\uB2C8\uB2E4.\n\u2022 \uD68C\uBCF5\uC6A9\uC73C\uB85C
    \uB0A8\uAE38 \uC801\uACFC \uC0AC\uACA9\uD574 \uC904\uC77C \uC801\uC744 \uC804\uB7B5\uC801\uC73C\uB85C
    \uC120\uD0DD\uD574 \uCD5C\uB300\uD55C \uC624\uB798 \uC0DD\uC874\uD558\uC138\uC694!"
  m_isRightToLeft: 0
